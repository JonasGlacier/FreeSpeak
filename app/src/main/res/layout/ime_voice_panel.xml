<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imeRootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_bg"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Fixed-height design canvas (all positions are dp from the top) -->
    <FrameLayout
        android:id="@+id/panelCanvas"
        android:layout_width="match_parent"
        android:layout_height="206dp">

        <!-- Punctuation row -->
        <LinearLayout
            android:id="@+id/punctRow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPunct1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text=","
            android:textColor="@color/ime_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPunct2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="."
            android:textColor="@color/ime_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPunct3"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text=":"
            android:textColor="@color/ime_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPunct4"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text=";"
            android:textColor="@color/ime_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPunct5"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="!"
            android:textColor="@color/ime_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPunct6"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/ime_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPunct7"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="@"
            android:textColor="@color/ime_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPunct8"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="/"
            android:textColor="@color/ime_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvImeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/status_idle_hybrid"
            android:textColor="@color/ime_text_secondary"
            android:textSize="12sp" />

        <!-- Left column -->
    <ImageButton
        android:id="@+id/btnRedo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_ime_round"
        android:contentDescription="@string/ime_cd_redo"
        android:scaleType="centerInside"
        android:src="@drawable/ic_redo" />

    <ImageButton
        android:id="@+id/btnUndo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="116dp"
        android:background="@drawable/bg_ime_round"
        android:contentDescription="@string/ime_cd_undo"
        android:scaleType="centerInside"
        android:src="@drawable/ic_undo" />

    <ImageButton
        android:id="@+id/btnOpenSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="160dp"
        android:background="@drawable/bg_ime_round"
        android:contentDescription="@string/ime_cd_settings"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings" />


        <!-- Right column -->
        <TextView
            android:id="@+id/btnLang"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="116dp"
            android:background="@drawable/bg_ime_round"
            android:contentDescription="@string/ime_cd_translate"
            android:gravity="center"
            android:text="EN"
            android:textColor="@color/ime_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnTargetIme"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="160dp"
        android:background="@drawable/bg_ime_round"
        android:contentDescription="@string/ime_cd_target_ime"
        android:scaleType="centerInside"
        android:src="@drawable/ic_globe_keyboard" />


        <!-- Bottom key row -->
        <LinearLayout
            android:id="@+id/bottomRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="58dp"
            android:layout_marginTop="160dp"
            android:layout_marginEnd="58dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSpace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ime_key"
                android:contentDescription="@string/ime_key_space"
                android:gravity="center"
                android:text="&#9251;"
                android:textColor="@color/ime_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEnter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="2.4"
                android:background="@drawable/bg_ime_key"
                android:gravity="center"
                android:text="@string/ime_key_return"
                android:textAllCaps="true"
                android:textColor="@color/ime_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnBackspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ime_key"
                android:contentDescription="@string/ime_cd_backspace"
                android:scaleType="centerInside"
                android:src="@drawable/ic_backspace" />
        </LinearLayout>

        <!-- Mic: pill when idle, circle when recording (height animated by the service) -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="164dp"
            android:layout_height="68dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="70dp"
            android:background="@drawable/bg_mic_idle"
            android:contentDescription="@string/ime_cd_mic"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic" />

        <com.freespeak.ime.ime.VoiceWaveformView
            android:id="@+id/waveformView"
            android:layout_width="164dp"
            android:layout_height="64dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="72dp"
            android:visibility="gone" />

        <!-- Cancel recording -->
        <ImageButton
            android:id="@+id/btnCancelRecording"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_ime_round"
            android:contentDescription="@string/ime_cd_cancel_recording"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
