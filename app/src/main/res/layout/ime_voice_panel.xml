<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imeRootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- Top Toolbar: Model switcher, Language capsule, Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnModelSwitch"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_capsule"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/ime_no_model_tap"
            android:textColor="@color/ime_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnLangSwitch"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ime_capsule"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/pref_lang_auto_mixed"
            android:textColor="@color/ime_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ime_capsule"
            android:contentDescription="@string/ime_cd_settings"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Quick Punctuation Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPunct1"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text=","
            android:textColor="@color/ime_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPunct2"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="."
            android:textColor="@color/ime_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPunct3"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/ime_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPunct4"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="!"
            android:textColor="@color/ime_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPunct5"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text=";"
            android:textColor="@color/ime_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPunct6"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text=":"
            android:textColor="@color/ime_text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Waveform + Status Hint -->
    <com.freespeak.ime.ime.VoiceWaveformView
        android:id="@+id/waveformView"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvImeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/status_idle_hybrid"
        android:textColor="@color/ime_text_secondary"
        android:textSize="12sp" />

    <!-- Main Action Row: Switch IME | Space | Big Mic | Backspace | Enter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnSwitchIme"
            android:layout_width="50dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_ime_key"
            android:contentDescription="@string/ime_cd_switch_ime"
            android:scaleType="centerInside"
            android:src="@drawable/ic_globe_keyboard" />

        <TextView
            android:id="@+id/btnSpace"
            android:layout_width="54dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="@string/ime_key_space"
            android:textColor="@color/ime_text_primary"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_idle"
                android:contentDescription="@string/ime_cd_mic"
                android:elevation="3dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="50dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:contentDescription="@string/ime_cd_backspace"
            android:scaleType="centerInside"
            android:src="@drawable/ic_backspace" />

        <TextView
            android:id="@+id/btnEnter"
            android:layout_width="58dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:text="@string/ime_key_return"
            android:textColor="@color/ime_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
