    <string name="onboarding_pillar_offline_desc">Voice never leaves your device. Zero network requests while typing.</string>
    <string name="onboarding_pillar_uncensored">Uncensored &amp; Raw</string>
    <string name="onboarding_pillar_uncensored_desc">No word filtering, no content moderation, no telemetry.</string>

