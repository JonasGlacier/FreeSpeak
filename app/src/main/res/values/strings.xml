    <!-- Sub-screen: Recording Mode -->
    <string name="sub_recording_desc">Choose how the microphone button responds when you dictate.</string>
    <string name="mode_hybrid_desc">Tap once to start or stop; press and hold to talk and release to transcribe immediately (slide up to cancel).</string>
    <string name="mode_tap_desc">Tap the microphone to start listening, and tap again when finished.</string>
    <string name="mode_hold_desc">Hold down the microphone while speaking, release to transcribe immediately, or slide up to cancel.</string>

    <!-- Sub-screen: Preferred Languages -->
    <string name="sub_language_desc">Select the languages you speak. Selecting multiple languages enables automatic mixed-language recognition (code-switching) and quick cycling on the keyboard.</string>
    <string name="sub_language_whisper_prompt">Punctuation &amp; Mixed-Script Hint (Whisper)</string>
    <string name="sub_language_whisper_prompt_desc">Guides Whisper models to output full punctuation and clean mixed-language text.</string>

    <!-- Sub-screen: VAD -->
    <string name="sub_vad_desc">Uses on-device Silero VAD to detect voice activity and trim leading, trailing, and long silent gaps. Sentences are never split into fragments, preserving natural model punctuation.</string>
    <string name="sub_vad_enable">Enable Voice Detection &amp; Silence Filter</string>
    <string name="sub_vad_sensitivity">Detection Threshold (%1$s)</string>
    <string name="sub_vad_sensitivity_hint">Lower values pick up softer speech; higher values ignore louder background noise.</string>

