    <!-- Sub-screen: Recording Mode -->
    <string name="sub_recording_desc">选择按下麦克风按钮时的录音交互方式。</string>
    <string name="mode_hybrid_desc">短按开始或结束录音；按住说话松手立即转写（手指上滑可取消）。</string>
    <string name="mode_tap_desc">轻点麦克风开始录音，说完再次点击完成转写。</string>
    <string name="mode_hold_desc">按住麦克风说话，松开手指立即转写，上滑取消本次录音。</string>

    <!-- Sub-screen: Preferred Languages -->
    <string name="sub_language_desc">勾选你日常使用的语言。勾选多种语言时将自动启用多语言混输识别（如中英夹杂），并可在键盘顶栏快速切换。</string>
    <string name="sub_language_whisper_prompt">标点与中英混输引导（Whisper）</string>
    <string name="sub_language_whisper_prompt_desc">使用 Whisper 系列模型时自动提示输出简体标点与自然中英混排。</string>

    <!-- Sub-screen: VAD -->
    <string name="sub_vad_desc">通过本地 Silero VAD 检测人声活动，自动滤除首尾留白与过长静音以防静音幻觉并降低算力消耗；绝不切碎句子，完整保留模型原生标点。</string>
    <string name="sub_vad_enable">开启语音检测与静音过滤</string>
    <string name="sub_vad_sensitivity">人声检测阈值（%1$s）</string>
    <string name="sub_vad_sensitivity_hint">数值越小对轻声越灵敏；周围环境嘈杂时可适当调高。</string>

    <!-- Sub-screen: Models -->
    <string name="sub_models_desc">所有模型均在本地离线运行。你可以随时切换或接入新模型，无需等待应用更新。</string>
    <string name="model_size_format">%1$d MB · %2$s</string>
    <string name="model_downloading_format">%1$s · %2$d / %3$d MB (%4$s)</string>
    <string name="model_extracting">正在解压模型文件…</string>

    <!-- Model Catalog Descriptions -->
    <string name="model_desc_funasr_nano">FunAudioLLM 轻量多语言与方言模型，支持中英混说与自动标点，单次前向推理极快。</string>
    <string name="model_desc_qwen3_asr">通义千问 0.6B 多模态语音小模型，中英夹杂、专业词汇及标点断句表现极佳。</string>
    <string name="model_desc_whisper_small">均衡型 99 语种 Whisper 量化模型（基于 whisper.cpp 原生推理）。</string>
    <string name="model_desc_sensevoice">支持中、粤、英、日、韩识别，自动恢复标点与数字格式，响应迅速。</string>
    <string name="model_desc_whisper_tiny">仅约 32 MB 的超轻模型，适合低配设备或快速体验。</string>

