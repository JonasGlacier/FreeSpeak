    <!-- Onboarding -->
    <string name="onboarding_welcome_title">纯粹、私密的语音输入</string>
    <string name="onboarding_welcome_subtitle">支持多语言与中英混说，所有运算完全在手机本地完成。</string>
    <string name="onboarding_pillar_free">免费且开源</string>
    <string name="onboarding_pillar_free_desc">无订阅收费，开放接入任意新模型，不依赖官方更新。</string>
    <string name="onboarding_pillar_offline">100% 离线运算</string>
    <string name="onboarding_pillar_offline_desc">输入法进程零联网，语音数据从不离开你的手机。</string>
    <string name="onboarding_pillar_uncensored">无审查 · 保护隐私</string>
    <string name="onboarding_pillar_uncensored_desc">无敏感词过滤，无内容审查，不收集任何遥测日志。</string>

    <string name="onboarding_perm_title">授予麦克风权限</string>
    <string name="onboarding_perm_desc">仅用于在本地内存中采集语音并交由离线模型识别。</string>
